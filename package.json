{
  "name": "@danielfrg/things",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:server": "vp run --filter @danielfrg/things-server dev",
    "start:server": "vp run --filter @danielfrg/things-server start",
    "dev:web": "vp run --filter @danielfrg/things-web dev",
    "start": "vp run commands",
    "build:sdk": "vp run --filter @danielfrg/things-sdk build",
    "build:web": "vp run --filter @danielfrg/things-web build",
    "db:generate": "vp run --filter @danielfrg/things-server db:generate",
    "db:migrate": "vp run --filter @danielfrg/things-server db:migrate",
    "db:reset": "vp run --filter @danielfrg/things-server db:reset",
    "db:seed": "vp run --filter @danielfrg/things-server db:seed",
    "db:studio": "vp run --filter @danielfrg/things-server db:studio",
    "cli": "vp run --filter @danielfrg/things-cli start",
    "cli:build": "vp run --filter @danielfrg/things-cli build",
    "typecheck": "vp run -r typecheck",
    "commands": "node scripts/list-commands.mjs",
    "clean:modules": "node scripts/clean-modules.mjs",
    "format": "vp fmt \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "reset": "rm -rf node_modules packages/*/node_modules packages/*/.turbo .turbo pnpm-lock.yaml packages/*/dist",
    "prepare": "vp config"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "ts-morph": "^27.0.2",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:",
    "vite-plus": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
