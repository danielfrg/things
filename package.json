{
  "name": "things",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev:server": "bun run --cwd packages/server dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build:sdk": "bun run --cwd packages/sdk build",
    "build:web": "bun run --cwd packages/web build",
    "db:generate": "bun run --cwd packages/server db:generate",
    "db:migrate": "bun run --cwd packages/server db:migrate",
    "db:reset": "bun run --cwd packages/server db:reset",
    "db:seed": "bun run --cwd packages/server db:seed",
    "db:studio": "bun run --cwd packages/server db:studio",
    "cli": "bun run packages/cli/index.ts",
    "cli:build": "bun run packages/cli/script/build.ts",
    "typecheck": "bun turbo typecheck",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "1.3.6",
      "@types/node": "22.10.2",
      "@hono/zod-validator": "0.7.6",
      "@kobalte/core": "0.13.9",
      "@solidjs/router": "0.15.4",
      "@tailwindcss/vite": "4.1.18",
      "better-auth": "1.4.18",
      "date-fns": "4.1.0",
      "hono": "4.11.4",
      "hono-openapi": "1.2.0",
      "prettier": "3.8.1",
      "solid-js": "1.9.10",
      "tailwindcss": "4.1.18",
      "typescript": "5.7.2",
      "typescript-language-server": "5.1.3",
      "ulid": "3.0.2",
      "vite": "6.0.0",
      "vite-plugin-solid": "2.11.10",
      "zod": "4.3.5"
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "ts-morph": "^27.0.2",
    "typescript": "catalog:",
    "typescript-language-server": "catalog:"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
